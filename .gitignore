# .gitignore: Exclude personal settings, secrets, caches, and generated build output.

# Personal project and agent preferences.
AGENTS.local.md
*.local.md
local.md

# Local credentials; keep shareable example configuration.
.env
.env.*
!.env.example

# Operating system and editor temporary files.
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# JavaScript dependencies and generated build output.
node_modules/
/dist/
/build/

# Reference captures from the signboard's capture key (src/robot/vision/capture.py).
/captures/

# Keep images, CAD sources/exports, and application PDFs tracked.

# Large tablecloth artwork stays local pending explicit size approval.
/images/makerfaire/tablecloth/tablecloth_maekake_1800_1570.ai
/images/makerfaire/tablecloth/tablecloth.psd
